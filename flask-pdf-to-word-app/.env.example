# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# Set to 'true' only during local development
FLASK_DEBUG=false

# Server port — 5123 is used to avoid conflict with TrueNAS on port 5000
PORT=5123

# Maximum upload size in megabytes (default: 50)
MAX_UPLOAD_MB=50

# Folders for uploaded PDFs and converted Word files
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
